{
  "compilerOptions": {
    "module": "preserve",
    "target": "ES5",
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "strict": true,
    "typeRoots": [
      "node_modules/@types",
      "typings"
    ]
  },
  "include": [
    "components/**/*.ts",
    "storybook/global.d.ts",
    "templates/**/*.ts"
  ],
  "exclude": [
    "**/*.stories.ts",
    "components/index.ts"
  ]
}
