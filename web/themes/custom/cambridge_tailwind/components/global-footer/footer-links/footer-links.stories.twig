          'icon': 'linkedin'
        },
        {
          'url': 'https://www.instagram.com',
          'label': 'Instagram',
          'is_external': true,
          'icon': 'instagram'
        },
        {
          'url': 'https://www.facebook.com',
          'label': 'Facebook',
          'is_external': true,
          'icon': 'facebook'
        },
        {
          'url': 'https://www.youtube.com',
          'label': 'Youtube',
          'is_external': true,
          'icon': 'youtube'
        },
      ],
    }
    }
  %}
    {% include "cambridge_tailwind:footer-links" with {
      label: label,
      links: links
    } %}
  {% endstory %}


{% endstories %}
