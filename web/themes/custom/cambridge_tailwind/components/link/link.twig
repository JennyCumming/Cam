{# Calculate the classes in a macro so they can be extracted elsewhere #}
{% macro linkClasses (dark = false, inline = false) %}
	{# Note that if changing non-dark link classes, in order to see prose versions of these classes generated you will need to update the `safelist` in tailwind.config.ts #}
	{# Make sure to test the prose versions of these classes in the prose component when making changes #}
  {% set link_classes = [
    'underline-offset-4', 'decoration-1',
    'hover:underline',
    'active:underline', 'active:bg-transparent', 'active:shadow-none'
  ] %}

	{% if inline %}
		{% set link_classes = link_classes|merge([
			'underline'
		]) %}
	{% else %}
		{% set link_classes = link_classes|merge([
			'no-underline'
		]) %}
	{% endif %}

  {% if dark %}
  	{# Dark / contrast colours #}
  	{# TODO: Adding in focus styles as part of am#109 #}
    {% set link_classes = link_classes|merge([
			'text-link-contrast',
			'hover:text-link-contrast-hover', 'hover:decoration-link-contrast',
			'active:text-link-contrast-active', 'active:decoration-link-contrast-active'
		]) %}
  {% else %}
  	{# Default / light colours #}
  	{# TODO: Adding in focus styles as part of am#109 #}
    {% set link_classes = link_classes|merge([
      'text-link-default',
      'hover:text-link-hover', 'hover:decoration-link-default',
      'active:text-link-active', 'active:decoration-link-default',
    ]) %}
  {% endif %}

	{# Output as space separated list #}
  {{ link_classes|join(' ') }}
{% endmacro %}

{% if not attributes %}
	{% set attributes = create_attribute() %}
{% endif %}
{% set attributes = attributes.addClass(_self.linkClasses(dark, inline) | spaceless) %}
{% if external %}
	{% set attributes = attributes.setAttribute('rel', 'noopener noreferrer').setAttribute('target', '_blank') %}
{% endif %}

<a{{ attributes }} href="{{ url }}">{% apply spaceless %}
	{{ content | raw }}
{% endapply %}</a>
