{% stories icon_link_id with
  {
    title: 'Components/IconLink',
    argTypes: {
      url: {
        control: { type: "text" },
      },
      text: {
        control: { type: "text" },
      },
      position: {
        control: { type: "select" },
        options: ['left', 'right']
      }
    },
  }
%}

  {% story icon_link_1 with
    {
      name: '1. Arrow icon link',
      args: {
        url: '#',
        text: 'Start',
      }
    }
  %}
    {% set icon %}
      {% include '@cambridge_tailwind/components/link/icons/arrow-right.twig' %}
    {% endset %}
    <div class="flex gap-8 flex-col p-8">
      <p class="text-style-body-lg">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, position } %}
      </p>
      <p class="text-style-body-md">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, position } %}
      </p>
      <p class="text-style-body-sm">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, position } %}
      </p>
    </div>
    <div class="flex gap-8 flex-col p-8 bg-black">
      <p class="text-style-body-lg">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, position, dark: true } %}
      </p>
      <p class="text-style-body-md">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, position, dark: true } %}
      </p>
      <p class="text-style-body-sm">
      {% include '@cambridge_tailwind/components/link/icon-link.twig' with { url, text, icon, positio, dark: true } %}
      </p>
    </div>
  {% endstory %}

