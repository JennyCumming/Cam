<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
* Implements hook_theme_suggestions_alter().
*/
function cam_admin_ui_tweaks_theme_suggestions_alter(array &$suggestions, array $variables, $hook) {
  switch ($hook) {
    case 'paragraph':
      $suggestions[] = $hook . '__' . 'admin_' . $variables['elements']['#view_mode'];
    break;
  }
}

function cam_admin_ui_tweaks_page_attachments(array &$attachments) {
  // Return Message Banner styling for all users.
  $attachments['#attached']['library'][] = 'cambridge_tailwind/message-banner-styling';

  $is_admin = \Drupal::service('router.admin_context')->isAdminRoute();
  if ($is_admin) {
    $attachments['#attached']['library'][] = 'cam_admin_ui_tweaks/ckeditor';
    $attachments['#attached']['library'][] = 'cam_admin_ui_tweaks/paragraphs_ee';
    return;
  }
}

/**
* Implements hook_theme().
*/
function cam_admin_ui_tweaks_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__admin_preview' => [
      'base hook' => 'paragraph',
      'path' => $path . '/templates/paragraphs',
    ],
  ];
}

function cam_admin_ui_tweaks_preprocess_paragraph(&$variables) {
  $entity = $variables['paragraph'];
  $entity_type = $entity->getEntityTypeId();
  $entity_bundle = $entity->bundle();
  $bundle_info = \Drupal::service('entity_type.bundle.info')->getBundleInfo($entity_type);
  $variables['title'] = $bundle_info[$entity_bundle]['label'];
}

 /**
 * Implements hook_library_info_alter().
 */
function cam_admin_ui_tweaks_library_info_alter(array &$libraries, $extension)
{
  if ($extension === 'message_banner' && isset($libraries['message_banner'])) {
    $libraries['message_banner']['header'] = true;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function cam_admin_ui_tweaks_form_system_theme_settings_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Only alter the form for cambridge_tailwind theme
  if (empty($form_state->getBuildInfo()['args'][0]) || $form_state->getBuildInfo()['args'][0] !== 'cambridge_tailwind') {
    return;
  }

  // Add colour scheme fieldset
  $form['color_scheme'] = [
    '#type' => 'details',
    '#title' => t('Colour scheme'),
    '#open' => TRUE,
    '#weight' => -100,
  ];

  // Add colour scheme select with color box
  $form['color_scheme']['color_wrapper'] = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['color-select-wrapper'],
    ],
  ];

  $form['color_scheme']['color_wrapper']['color'] = [
    '#type' => 'select',
    '#title' => t('Theme colour'),
    '#options' => [
      'teal' => t('Teal'),
      'purple' => t('Purple'),
      'green' => t('Green'),
      'cherry' => t('Cherry'),
      'grey' => t('Grey'),
      'blue' => t('Blue'),
    ],
    '#default_value' => \Drupal::config('cambridge_tailwind.settings')->get('color') ?: 'teal',
    '#description' => t('<br>Select the primary colour scheme for your site.'),
  ];

  $colors = [
    'teal' => '#034553',
    'purple' => '#4A2173',
    'green' => '#0F4933',
    'cherry' => '#74062E',
    'grey' => '#36404F',
    'blue' => '#14476B',
  ];
  
  $current_color = \Drupal::config('cambridge_tailwind.settings')->get('color') ?: 'teal';
  
  $form['color_scheme']['color_wrapper']['color_box'] = [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => [
      'class' => ['color-preview-box'],
      'style' => 'background-color: ' . $colors[$current_color] . ';',
      'data-colors' => json_encode([
        'teal' => '#034553',
        'purple' => '#4A2173',
        'green' => '#0F4933',
        'cherry' => '#74062E',
        'grey' => '#36404F',
        'blue' => '#14476B',
      ]),
    ],
  ];

  // Add submit handler to save color setting
  $form['#submit'][] = 'cam_admin_ui_tweaks_theme_settings_submit';
  
  // Attach the color preview library
  $form['#attached']['library'][] = 'cam_admin_ui_tweaks/color-preview';
}

/**
 * Submit handler for theme settings form.
 */
function cam_admin_ui_tweaks_theme_settings_submit($form, FormStateInterface $form_state) {
  if ($color = $form_state->getValue(['color_scheme', 'color_wrapper', 'color'])) {
    \Drupal::configFactory()->getEditable('cambridge_tailwind.settings')
      ->set('color', $color)
      ->save();
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 */
function cam_admin_ui_tweaks_field_widget_complete_form_alter(&$field_widget_complete_form, FormStateInterface $form_state, $context) {
  // Check if the paragraphs widget exists and is enabled.
  if (isset($field_widget_complete_form['widget']['#paragraphs_widget']) && $field_widget_complete_form['widget']['#paragraphs_widget']) {
    
    // Loop through the widget array.
    foreach ($field_widget_complete_form['widget'] as &$widget) {
      // Make sure $widget is an array before using array access.
      if (is_array($widget) && isset($widget['top'])) {
        // Unset the icon from the 'type' within 'top' if it exists.
        if (isset($widget['top']['type']['icon'])) {
          unset($widget['top']['type']['icon']);
        }
      }
    }
  }
}
